# HOM Studio OS v2 local placeholders
# Copy to apps/web/.env.local only for local development.
# Never commit real secrets, production URLs, or service-role keys.

# Public app metadata
NEXT_PUBLIC_APP_NAME="HOM Studio OS v2"

# Phase 2 mode flags. Keep mock defaults until real auth/data is approved.
HOM_AUTH_MODE="mock"
HOM_DATA_MODE="mock"

# Supabase local-first placeholders. Do not link or push to a cloud project in Phase 2.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL=""

# AI and messaging placeholders for later phases. Keep empty.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""

# Demo-only AI Business Summary (OpenRouter). Server-only — never expose to the browser.
# Never add NEXT_PUBLIC_OPENROUTER_API_KEY. Keep these empty/false in the repo.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4.1-mini"
AI_DEMO_ENABLED="false"

# Observability placeholders for later phases.
SENTRY_DSN=""
POSTHOG_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
