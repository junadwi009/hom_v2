{
  "name": "hom-studio-os-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "corepack pnpm --dir apps/web dev",
    "build": "corepack pnpm --dir apps/web build",
    "lint": "corepack pnpm --dir apps/web lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "storybook": "corepack pnpm --dir apps/web storybook",
    "build-storybook": "corepack pnpm --dir apps/web build-storybook",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --dir apps/web test:e2e"
  },
  "devDependencies": {
    "supabase": "^2.101.0"
  }
}
